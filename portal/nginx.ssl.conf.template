# HTTPS nginx — enabled after init-ssl.sh (profile: ssl)
# Same token as HTTP portal: one portal_session cookie, Frigate on port 5000.
# Path prefixes (/cafe/, …) on the apex host — no per-site subdomain (those
# would be a second origin and would not share a host-only cookie).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${CCTV_DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${CCTV_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${CCTV_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CCTV_DOMAIN}/privkey.pem;
    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    include /usr/share/nginx/html/nginx-portal-locations.inc;
}
