# SSL + Let's Encrypt (optional)
# Copy to .env and run: ./scripts/init-ssl.sh
#
# CCTV_DOMAIN=cctv.shahrhotel.ir
# CCTV_EMAIL=admin@shahrhotel.ir
#
# DNS records required (point to server public IP):
#   cctv.shahrhotel.ir       → portal
#   cafe.cctv.shahrhotel.ir  → frigate-cafe (via nginx)
#   center11.cctv.shahrhotel.ir → frigate-center11
#
# Let's Encrypt cannot issue certificates for bare IP addresses (192.168.x.x).

# =============================================================================
# Camera → IT task notifier (camera-ticket-notifier)
# Copy these into .env on the server. Do not commit real API keys.
# =============================================================================
#
# IT_TASKS_ENABLED=0          # 1 = allow real POST to IT
# IT_TASKS_DRY_RUN=0          # 1 = log payload only, never call IT
# IT_TASKS_API_KEY=           # Bearer key from IT admin
# IT_TASKS_BASE_URL=http://188.121.144.90:5000/api/v1
# IT_TASKS_ASSIGNEE=faraji              # مسئول: فرجی
# IT_TASKS_COLLABORATORS=bahrami,sahragard  # همکاران (API: collaborator_usernames)
# IT_TASKS_COLLABORATOR_LABELS=بهرامی، صحراگرد
# IT_TASKS_PRIORITY=high
# IT_TASKS_CYCLE_SEC=60       # هر چند ثانیه یک‌بار چک
# IT_TASKS_FAIL_THRESHOLD=3   # چند بار پشت‌سرهم قطع → بعد تسک (~۳ دقیقه)
# IT_TASKS_BOOTSTRAP_TICKET=0 # 0 = دوربین‌های ازقبل‌قطع در روز اول تسک نگیرند
# IT_TASKS_ALLOWLIST=         # مثلاً center11:cam_5 برای تست محدود
# IT_TASKS_DENYLIST=
